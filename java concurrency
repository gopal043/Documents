class SumTask
extends RecursiveTask<Long> {


    private int[] array;

    private int start;

    private int end;


    SumTask(
        int[] array,
        int start,
        int end
    ){
        this.array=array;
        this.start=start;
        this.end=end;
    }



    protected Long compute(){

        if(end-start < 1000){

            long sum=0;

            for(int i=start;i<end;i++){

                sum += array[i];

            }

            return sum;

        }


        int mid =
            (start+end)/2;


        SumTask left =
            new SumTask(
                array,
                start,
                mid
            );


        SumTask right =
            new SumTask(
                array,
                mid,
                end
            );


        left.fork();


        long rightResult =
            right.compute();


        long leftResult =
            left.join();


        return
            leftResult + rightResult;

    }

}


