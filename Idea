Example Usage

<dependency>
   <groupId>com.gk</groupId>
   <artifactId>gk-security-starter</artifactId>
   <version>1.0.0</version>
</dependency>

gk:
  security:
    provider: azure

  mfa:
    enabled: true

  audit:
    enabled: true


